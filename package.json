{
  "name": "abufolio",
  "version": "1.0.0",
  "description": "Personal portfolio of Basith AbuSyed — data, analytics and applied AI projects.",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./css/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./css/styles.css --watch",
    "build:assets": "node scripts/build-assets.mjs",
    "build": "npm run build:css && npm run build:assets",
    "shots": "node scripts/capture-previews.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abustark/abufolio.git"
  },
  "keywords": [
    "portfolio",
    "data-analytics",
    "machine-learning",
    "applied-ai",
    "full-stack",
    "static-site",
    "tailwindcss"
  ],
  "author": "Basith AbuSyed",
  "license": "UNLICENSED",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/abustark/abufolio/issues"
  },
  "homepage": "https://abufolio.vercel.app/",
  "devDependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "autoprefixer": "^10.4.21",
    "playwright": "^1.63.0",
    "postcss": "^8.5.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.13"
  }
}
